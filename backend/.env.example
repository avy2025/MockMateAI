# Backend Environment Variables Example

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://mongodb:27017/mockmateai

# Gemini API Key (Required for AI interactions)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (Required for authentication)
JWT_SECRET=your_jwt_secret_here

# Cloud Storage Variables (Placeholders as requested)
CLOUD_STORAGE_BUCKET=your_storage_bucket_here
CLOUD_STORAGE_CREDENTIALS=your_storage_credentials_here
